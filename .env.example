# Kisan Sahayak - Configuration Template
# DO NOT COMMIT REAL SECRETS OR PASSWORDS TO SOURCE CONTROL

# ---------------------------------------------------------------------
# 1. Supabase Frontend Configuration (Public Anon Key)
# ---------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# ---------------------------------------------------------------------
# 2. Supabase Server-Side Configuration (Private Service-Role Key)
# Set SUPABASE_URL to the same project URL as VITE_SUPABASE_URL.
# NEVER expose this key in frontend code or prefix with VITE_
# ---------------------------------------------------------------------
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ---------------------------------------------------------------------
# 3. Private Admin Credentials (Server-Side)
# ---------------------------------------------------------------------
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=

# ---------------------------------------------------------------------
# 4. Server Authentication Secret
# ---------------------------------------------------------------------
JWT_SECRET=

# ---------------------------------------------------------------------
# 5. Server Port
# ---------------------------------------------------------------------
PORT=3000
