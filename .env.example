# Kisan Sahayak - Server-Side Configuration
# DO NOT COMMIT REAL SECRETS OR PASSWORDS TO SOURCE CONTROL

# 1. Private Admin Credentials
# ADMIN_USERNAME: The sole private username for the administrator
# ADMIN_PASSWORD_HASH: The bcrypt password hash (e.g. generated via `npm run setup-admin`)
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=

# 2. Server Authentication Secret
# JWT_SECRET: Random 32+ character string used to sign backend session tokens
JWT_SECRET=

# 3. Server Port
PORT=3000
